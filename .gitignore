*.pyc
.env

# Logs
ur5_agent/logs/

# Data (large files — keep structure via .gitkeep)
data/raw/images/**/*
!data/raw/images/**/.gitkeep
data/raw/video/**/*
!data/raw/video/**/.gitkeep
data/raw/robot_sessions/**/*
!data/raw/robot_sessions/**/.gitkeep
!data/raw/robot_sessions/.gitkeep
data/synthetic/**/*
!data/synthetic/**/.gitkeep
data/labels/**/*
!data/labels/**/.gitkeep
data/datasets/**/*
!data/datasets/**/.gitkeep
data/models/**/*
!data/models/**/.gitkeep

# Local-only branding (never push)
ur5_agent/ui/web/brand/

# URDF vendor clones (large; re-fetch with scripts/fetch_ur5_urdf.sh)
assets/_vendor/
assets/robots/ur5_robotiq/urdf/_build_vendor/
assets/robots/ur5_robotiq/urdf/.ur5_robotiq.build.xacro
